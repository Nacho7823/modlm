      "updated": 1776037718999,
      "link": null,
      "locked": false,
      "text": "    { \n        \"hello3d\": { \"type\": \"remote\", \"url\": \"http://127.0.0.1:3003/mcp\" },\n        \"stitch\": {\n            \"type\": \"remote\",\n            \"url\": \"https://stitch.googleapis.com/mcp\",\n            \"enabled\": true,\n            \"headers\": {\n                \"X-Goog-Api-Key\": \"wawfawfdgfrgregergsefefefgweg\"\n            }\n        },\n        \"figma\": {\n            \"type\": \"remote\",\n            \"url\": \"https://mcp.figma.com/mcp\",\n            \"headers\": {\n                \"Authorization\": \"Bearer fefwerehthrthrhthrhthrhtrhhth\"\n            }\n        },\n        \"MCP_DOCKER\": {\n            \"type\": \"local\",\n            \"command\": [\"docker\", \"mcp\", \"gateway\", \"run\"],\n            \"enabled\": true\n        }\n    },",
      "fontSize": 27.636363636363626,
